# Copy into Vercel → Project → Settings → Environment Variables.

# Shared secret GHL and Gumloop send in the `x-phazed-key` header.
# Generate one with: openssl rand -hex 32
PHAZED_API_KEY=

# GHL → Settings → Private Integrations → new token with contacts.write scope.
# Optional: without it the API still prices jobs, it just doesn't write back to GHL.
GHL_PRIVATE_TOKEN=
